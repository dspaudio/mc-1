    "pitch_step": "round(65536 * 16000 / 44100 * 2**((note-root_midi)/12)); array indexed MIDI 0..108, supported playback 12..108",
    "duration_seconds": 0.384,
    "limitations": "Single velocity and single root recording per instrument; short excerpts with edited loop/fade, not full multisamples. Metrics establish bounds and provenance, not perceived tone quality."
